/* Configuración para Diseñadores Gráficos */
body {
    font-family: 'Comic sans', sans-serif;
    background-color: #204A75; /* Un azul oscuro de fondo */
    color: #333; /* Texto gris oscuro para mejor lectura */
    line-height: 1.6;
    margin: 0;
    padding: 20px;
}

header {
    background-color: #2c3e50; /* Un color elegante */
    color: blue;
    padding: 20px;
    text-align: center;
}

img {
    border-radius: 50%; /* Hace que la foto de perfil sea circular */
    border: 5px solid #fff;
    box-shadow: 0px 0px 10px rgba(0,0,0,0.1);
}

section {
    background: white;
    margin-top: 20px;
    padding: 20px;
    border-radius: 8px;
}
